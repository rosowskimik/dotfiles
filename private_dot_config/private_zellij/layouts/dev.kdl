layout {
	pane {
		borderless true
		plugin {
			datetime "{format}"
			datetime_format "%d %b %H:%M"
			datetime_timezone "Europe/Warsaw"
			format_hide_on_overlength true
			format_left "#[bg=#1e2030,fg=#cad3f5,bold] {session} {mode}{tabs}"
			format_precedence "lrc"
			format_right "#[bg=#1e2030,fg=#c6a0f6,bold] {datetime} "
			format_space "#[bg=#1e2030]"
			mode_enter_search "#[bg=#1e2030,fg=#f0c6c6]#[bg=#f0c6c6,fg=#181926,bold] ENT-SEARCH #[bg=#1e2030,fg=#f0c6c6]"
			mode_locked "#[bg=#1e2030,fg=#ed8796]#[bg=#ed8796,fg=#181926,bold]  #[bg=#1e2030,fg=#ed8796]"
			mode_move "#[bg=#1e2030,fg=#eed49f]#[bg=#eed49f,fg=#181926,bold] MOVE #[bg=#1e2030,fg=#eed49f]"
			mode_pane "#[bg=#1e2030,fg=#8bd5ca]#[bg=#8bd5ca,fg=#181926,bold] PANE #[bg=#1e2030,fg=#8bd5ca]"
			mode_prompt "#[bg=#1e2030,fg=#f5bde6]#[bg=#f5bde6,fg=#181926,bold] PROMPT #[bg=#1e2030,fg=#f0c6c6]"
			mode_rename_pane "#[bg=#1e2030,fg=#eed49f]#[bg=#eed49f,fg=#181926,bold] RENAME-PANE #[bg=#1e2030,fg=#eed49f]"
			mode_rename_tab "#[bg=#1e2030,fg=#eed49f]#[bg=#eed49f,fg=#181926,bold] RENAME-TAB #[bg=#1e2030,fg=#eed49f]"
			mode_resize "#[bg=#1e2030,fg=#eed49f]#[bg=#eed49f,fg=#181926,bold] RESIZE #[bg=#1e2030,fg=#eed49f]"
			mode_scroll "#[bg=#1e2030,fg=#f0c6c6]#[bg=#f0c6c6,fg=#181926,bold] SCROLL #[bg=#1e2030,fg=#f0c6c6]"
			mode_search "#[bg=#1e2030,fg=#f0c6c6]#[bg=#f0c6c6,fg=#181926,bold]  #[bg=#1e2030,fg=#f0c6c6]"
			mode_session "#[bg=#1e2030,fg=#f5bde6]#[bg=#f5bde6,fg=#181926,bold] SESSION #[bg=#1e2030,fg=#f0c6c6]"
			mode_tab "#[bg=#1e2030,fg=#8bd5ca]#[bg=#8bd5ca,fg=#181926,bold] TAB #[bg=#1e2030,fg=#8bd5ca]"
			mode_tmux "#[bg=#1e2030,fg=#c6a0f6]#[bg=#c6a0f6,fg=#181926,bold] TMUX #[bg=#1e2030,fg=#c6a0f6]"
			tab_active "#[bg=#1e2030,fg=#f5a97f]#[bg=#f5a97f,fg=#181926,bold] {index}{floating_indicator} #[bg=#1e2030,fg=#f5a97f]"
			tab_active_fullscreen "#[bg=#1e2030,fg=#f5a97f]#[bg=#f5a97f,fg=#181926,bold] {index}{fullscreen_indicator} #[bg=#1e2030,fg=#f5a97f]"
			tab_active_sync "#[bg=#1e2030,fg=#f5a97f]#[bg=#f5a97f,fg=#181926,bold] {index}{sync_indicator} #[bg=#1e2030,fg=#f5a97f]"
			tab_floating_indicator "󰹙"
			tab_fullscreen_indicator "󰊓"
			tab_normal "#[bg=#1e2030,fg=#cad3f5]#[bg=#cad3f5,fg=#181926,bold] {index}#[bg=#cad3f5,fg=#181926,bold]{floating_indicator} #[bg=#1e2030,fg=#cad3f5]"
			tab_normal_fullscreen "#[bg=#1e2030,fg=#cad3f5]#[bg=#cad3f5,fg=#181926,bold] {index}#[bg=#cad3f5,fg=#181926,bold]{fullscreen_indicator} #[bg=#1e2030,fg=#cad3f5]"
			tab_normal_sync "#[bg=#1e2030,fg=#cad3f5]#[bg=#cad3f5,fg=#181926,bold] {index}#[bg=#cad3f5,fg=#181926,bold]{sync_indicator} #[bg=#1e2030,fg=#cad3f5]"
			tab_separator ""
			tab_sync_indicator ""
			location "zjstatus"
		}
		size 1
	}
	pane
	// pane {
	// 	borderless true
	// 	plugin {
	// 		location "status-bar"
	// 	}
	// 	size 1
	// }
}
